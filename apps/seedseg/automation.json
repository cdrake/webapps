{
  "schemaVersion": 2,
  "app": "seedseg",
  "title": "SeedSeg",
  "description": "Detect prostate fiducial markers with the SeedSeg nnU-Net networks or the legacy v1 ensemble.",
  "defaultOperation": "segment",
  "operations": {
    "segment": {
      "title": "Segment fiducial markers",
      "description": "Run bias correction, the selected v2 networks (or the legacy v1 models), probability averaging and marker selection.",
      "mode": "batch",
      "inputs": {
        "image": {
          "source": "files",
          "type": "neuro:volume",
          "formats": [
            "nifti",
            "dicom"
          ],
          "description": "T1-weighted prostate MRI containing fiducial markers",
          "space": "native",
          "minimum": 1,
          "maximum": 1
        }
      },
      "parameters": {
        "model": {
          "type": "string",
          "description": "v2: nnU-Net 5-fold networks (default); v1: legacy 4-network U-Net consensus (default when only models is given)",
          "enum": [
            "v2",
            "v1"
          ]
        },
        "folds": {
          "type": "array",
          "description": "v2 networks (cross-validation folds) to average, default [0]; [0,1,2,3,4] is the evaluated ensemble",
          "items": {
            "type": "integer",
            "description": "Fold",
            "enum": [
              0,
              1,
              2,
              3,
              4
            ]
          }
        },
        "mirror": {
          "type": "boolean",
          "description": "v2 test-time mirroring (about 8 times slower)",
          "default": false
        },
        "models": {
          "type": "array",
          "description": "v1: one or more distinct model seeds, default all four",
          "items": {
            "type": "integer",
            "description": "Model seed",
            "enum": [
              42,
              123,
              456,
              789
            ]
          }
        },
        "threshold": {
          "type": "number",
          "description": "Marker probability threshold",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1
        },
        "markers": {
          "type": "integer",
          "description": "Implanted markers K: the K candidates with the highest mean probability are kept",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        }
      },
      "artifacts": {
        "markers": {
          "type": "neuro:mask",
          "mediaType": "application/x-nifti",
          "space": "native",
          "minimum": 1,
          "maximum": 1
        },
        "probability": {
          "type": "neuro:volume",
          "mediaType": "application/x-nifti",
          "space": "native",
          "minimum": 1,
          "maximum": 5
        }
      },
      "engines": [
        "browser"
      ]
    }
  }
}
