{
  "schemaVersion": 2,
  "app": "dwi2trx",
  "title": "dwi2trx",
  "description": "dwi2trx scientific workflow automation.",
  "defaultOperation": "tractography",
  "operations": {
    "fit": {
      "title": "Fit diffusion tensor",
      "description": "Fit diffusion tensor. Uses the same scientific processing handler as the interface.",
      "mode": "batch",
      "inputs": {
        "image": {
          "source": "files",
          "type": "neuro:volume",
          "formats": [
            "nifti",
            "dicom"
          ],
          "multiple": false,
          "required": true,
          "description": "Input image for processing"
        },
        "bval": {
          "source": "files",
          "type": "neuro:gradients",
          "formats": [
            "bval",
            "bvals"
          ],
          "multiple": false,
          "required": false,
          "description": "Explicit b values; required for NIfTI input unless DICOM supplies sidecars"
        },
        "bvec": {
          "source": "files",
          "type": "neuro:gradients",
          "formats": [
            "bvec",
            "bvecs"
          ],
          "multiple": false,
          "required": false,
          "description": "Explicit FSL gradient vectors; required unless DICOM supplies sidecars"
        },
        "metadata": {
          "source": "files",
          "type": "neuro:metadata",
          "formats": [
            "json"
          ],
          "multiple": false,
          "required": false,
          "description": "Optional acquisition metadata JSON"
        }
      },
      "parameters": {},
      "artifacts": {
        "fa": {
          "type": "neuro:volume",
          "mediaType": "application/gzip",
          "minimum": 1,
          "space": "input",
          "maximum": 1
        },
        "v1": {
          "type": "neuro:volume",
          "mediaType": "application/gzip",
          "minimum": 1,
          "space": "input",
          "maximum": 1
        }
      },
      "engines": [
        "browser"
      ]
    },
    "tractography": {
      "title": "Fit tensor and track streamlines",
      "description": "Fit tensor and track streamlines. Uses the same scientific processing handler as the interface.",
      "mode": "batch",
      "inputs": {
        "image": {
          "source": "files",
          "type": "neuro:volume",
          "formats": [
            "nifti",
            "dicom"
          ],
          "multiple": false,
          "required": true,
          "description": "Input image for processing"
        },
        "bval": {
          "source": "files",
          "type": "neuro:gradients",
          "formats": [
            "bval",
            "bvals"
          ],
          "multiple": false,
          "required": false,
          "description": "Explicit b values; required for NIfTI input unless DICOM supplies sidecars"
        },
        "bvec": {
          "source": "files",
          "type": "neuro:gradients",
          "formats": [
            "bvec",
            "bvecs"
          ],
          "multiple": false,
          "required": false,
          "description": "Explicit FSL gradient vectors; required unless DICOM supplies sidecars"
        },
        "metadata": {
          "source": "files",
          "type": "neuro:metadata",
          "formats": [
            "json"
          ],
          "multiple": false,
          "required": false,
          "description": "Optional acquisition metadata JSON"
        }
      },
      "parameters": {
        "seedFa": {
          "type": "number",
          "default": 0.25,
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum FA for seeding"
        },
        "stopFa": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum FA for propagation"
        },
        "stepSize": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.1,
          "maximum": 2,
          "description": "Tracking step size in voxels"
        },
        "maxAngle": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 90,
          "description": "Maximum turn angle in degrees"
        },
        "density": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 4,
          "description": "Seeds per voxel axis"
        }
      },
      "artifacts": {
        "fa": {
          "type": "neuro:volume",
          "mediaType": "application/gzip",
          "minimum": 1,
          "space": "input",
          "maximum": 1
        },
        "v1": {
          "type": "neuro:volume",
          "mediaType": "application/gzip",
          "minimum": 1,
          "space": "input",
          "maximum": 1
        },
        "tracts": {
          "type": "neuro:tractogram",
          "mediaType": "application/zip",
          "minimum": 1,
          "space": "RAS-mm",
          "maximum": 1
        }
      },
      "engines": [
        "browser"
      ]
    }
  }
}
