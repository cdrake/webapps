{
  "schemaVersion": 2,
  "app": "greedy",
  "title": "Greedy",
  "description": "Register a moving image to a fixed image with Greedy.",
  "defaultOperation": "register",
  "operations": {
    "register": {
      "title": "Register images",
      "description": "Run Greedy registration and reslice the moving image onto the fixed grid.",
      "mode": "batch",
      "inputs": {
        "moving": {
          "source": "files",
          "type": "neuro:volume",
          "formats": [
            "nifti",
            "dicom"
          ],
          "multiple": false,
          "required": true,
          "description": "Moving image to register",
          "space": "moving"
        },
        "fixed": {
          "source": "files",
          "type": "neuro:volume",
          "formats": [
            "nifti",
            "dicom"
          ],
          "multiple": false,
          "required": true,
          "description": "Fixed reference image",
          "space": "fixed"
        }
      },
      "parameters": {
        "method": {
          "type": "string",
          "enum": [
            "affine",
            "deformable"
          ],
          "default": "affine",
          "description": "Affine or affine followed by nonlinear registration"
        }
      },
      "artifacts": {
        "registered": {
          "type": "neuro:volume",
          "mediaType": "application/gzip",
          "space": "fixed",
          "minimum": 1,
          "maximum": 1
        },
        "affine": {
          "type": "neuro:transform",
          "mediaType": "text/plain",
          "space": "moving-to-fixed",
          "minimum": 1,
          "maximum": 1
        },
        "warp": {
          "type": "neuro:displacement-field",
          "mediaType": "application/gzip",
          "space": "fixed",
          "minimum": 0,
          "maximum": 1
        }
      },
      "engines": [
        "browser"
      ]
    }
  }
}
