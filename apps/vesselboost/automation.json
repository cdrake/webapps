{
  "schemaVersion": 2,
  "app": "vesselboost",
  "title": "VesselBoost",
  "description": "Segment vessels with explicit preprocessing and optional brain masking.",
  "defaultOperation": "segment",
  "operations": {
    "segment": {
      "title": "Segment vessels",
      "description": "Run the same load, downsample, bias correction, denoising and vessel inference steps as the UI.",
      "mode": "batch",
      "inputs": {
        "image": {
          "source": "files",
          "type": "neuro:volume",
          "formats": [
            "nifti",
            "dicom"
          ],
          "multiple": false,
          "required": true,
          "description": "TOF angiography or T2-star image suited to the chosen model",
          "space": "native"
        }
      },
      "parameters": {
        "model": {
          "type": "string",
          "description": "Published vessel segmentation model",
          "enum": [
            "manual",
            "omelette1",
            "omelette2",
            "t2s"
          ],
          "default": "manual"
        },
        "downsample": {
          "type": "integer",
          "description": "Downsampling factor;1 preserves resolution",
          "enum": [
            1,
            2,
            3,
            4
          ],
          "default": 1
        },
        "biasCorrection": {
          "type": "boolean",
          "description": "Run existing N4 bias correction",
          "default": true
        },
        "denoise": {
          "type": "string",
          "description": "Existing denoising method",
          "enum": [
            "none",
            "bilateral",
            "nlm-fast",
            "nlm"
          ],
          "default": "none"
        },
        "overlap": {
          "type": "number",
          "description": "Sliding-window overlap",
          "enum": [
            0,
            0.5,
            0.75,
            0.9
          ],
          "default": 0
        },
        "threshold": {
          "type": "number",
          "description": "Vessel probability threshold",
          "minimum": 0.01,
          "maximum": 0.5,
          "default": 0.1
        },
        "minimumComponentSize": {
          "type": "integer",
          "description": "Minimum vessel connected-component size in voxels",
          "minimum": 0,
          "default": 10
        },
        "brainExtraction": {
          "type": "string",
          "description": "Optional brain extraction applied after vessel inference",
          "enum": [
            "none",
            "bet",
            "synthstrip",
            "synthstrip-fast"
          ],
          "default": "none"
        },
        "brainThreshold": {
          "type": "number",
          "description": "BET fractional intensity",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        }
      },
      "artifacts": {
        "vessels": {
          "type": "neuro:mask",
          "mediaType": "application/x-nifti",
          "space": "analysis",
          "minimum": 1,
          "maximum": 1
        },
        "preprocessed": {
          "type": "neuro:volume",
          "mediaType": "application/x-nifti",
          "space": "analysis",
          "minimum": 0
        },
        "brain-mask": {
          "type": "neuro:mask",
          "mediaType": "application/x-nifti",
          "space": "analysis",
          "minimum": 0,
          "maximum": 1
        }
      },
      "engines": [
        "browser"
      ]
    }
  }
}
