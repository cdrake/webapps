{
  "schemaVersion": 2,
  "app": "edgereg",
  "title": "EdgeReg",
  "description": "Register a moving image to a fixed image with niimath allineate.",
  "defaultOperation": "register",
  "operations": {
    "register": {
      "title": "Register images",
      "description": "Run affine registration and reslice the moving image onto the fixed grid.",
      "mode": "batch",
      "inputs": {
        "moving": {
          "source": "files",
          "type": "neuro:volume",
          "formats": ["nifti", "dicom"],
          "multiple": false,
          "required": true,
          "description": "Moving image to register",
          "space": "moving"
        },
        "fixed": {
          "source": "files",
          "type": "neuro:volume",
          "formats": ["nifti", "dicom"],
          "multiple": false,
          "required": true,
          "description": "Fixed reference image",
          "space": "fixed"
        }
      },
      "parameters": {
        "robustFov": {
          "type": "boolean",
          "default": false,
          "description": "Crop the moving image with niimath robustfov before registration"
        }
      },
      "artifacts": {
        "registered": {
          "type": "neuro:volume",
          "mediaType": "application/x-nifti",
          "space": "fixed",
          "minimum": 1,
          "maximum": 1
        }
      },
      "engines": ["browser"]
    }
  }
}
