{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "packages/runtime-support/src/**",
    "packages/components/src/automation/**",
    "packages/desktop/src/contracts.js",
    "packages/desktop/src/resource-limits.js",
    "scripts/build-static.mjs",
    "scripts/lib/app-automation.mjs",
    "scripts/vendor-components.mjs",
    "scripts/lib/isolation-fallback-plugin.mjs",
    "scripts/lib/runtime-support.mjs",
    "scripts/vendor-runtime-support.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "playwright-report/**"
      ]
    },
    "lint": {},
    "brain-extraction#build": {
      "dependsOn": [
        "^build",
        "qsmbly#build"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  },
  "globalPassThroughEnv": [
    "TMPDIR"
  ]
}
